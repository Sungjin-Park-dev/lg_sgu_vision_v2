# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
env_isaacsim/

# Output artifacts
output/

# External/heavy directories
IsaacLab/
MotionComparator/
arm_coverage/
curobo/

# Locally-built ROS overlay (topic_based_ros2_control from source) — build artifact
ros2_overlay/

# Julia depot (GLNS.jl packages) — JULIA_DEPOT_PATH, populated by install_env.sh
.julia/
.uv-cache/

# Local tool state
.claude/
CLAUDE.md

# Isaac Sim auto-generated caches/artifacts
.thumbs/
Collected_*/

# Capture videos (large binary, do not version)
data/**/video*/

# Saved IK candidates (Check and Save IK / GLNS reuse; per object pose + options)
data/**/ik/

# Check-and-Save-IK 산출물(물체 배치별로 다시 생성되는 IK 관절해)
data/**/ik_solutions.h5

# 파이프라인 산출물 — mesh/ 와 코드로 다시 만들 수 있다.
#   viewpoint/  : viewpoint_studio 또는 core/viewpoint/cli.py
#   trajectory/ : core/glns/solve.py -> verify.py
# 전부 바이너리(h5/npz)라 diff 도 병합도 안 되고, 두 사람이 같은 물체를 재생성하면
# 매번 충돌한다. 입력 자산인 mesh/ 는 재생성이 불가능하므로 계속 추적한다.
# 특정 시점 산출물이 필요하면 히스토리에서 꺼낸다(인덱스를 건드리지 않도록 --worktree):
#   git restore --source=7a2159a --worktree -- data/sample/trajectory/74/
data/**/viewpoint/
data/**/trajectory/

# reorient_mesh.py backups
*.obj.bak

# 외부 반입 자료(대용량 CAD/스크래치 텍스처 드롭)
ff/

# Blender 작업파일(메시 편집용 소스, 산출물인 source.usd만 버전관리)
*.blend
*.blend[0-9]*

# 실험 산출물(솔버 결과 JSON/H5, 플롯) — 버전관리 제외
runs/

# 로컬 테스트 — 버전관리 제외(로컬에는 유지)
tests/

# 로컬 문서 이력 — 현행 사용자 문서만 버전관리
/docs/logs/
/docs/archive/
